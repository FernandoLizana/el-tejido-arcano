# ArcanaGraph Lab — ejemplo de variables de entorno
# Copia a .env y ajusta. Nunca commits .env con secretos reales.

ARCANAGRAPH_DATA_DIR=data
ARCANAGRAPH_CARDS_DIR=data/cards
ARCANAGRAPH_CACHE_DIR=data/cache
ARCANAGRAPH_SEED=42

# Opcional: proveedor de embeddings externo (desactivado por defecto)
# ARCANAGRAPH_EMBEDDING_PROVIDER=tfidf
# ARCANAGRAPH_API_EMBEDDING_URL=
# ARCANAGRAPH_API_EMBEDDING_KEY=

# Opcional: rutas a PDFs de fuentes (solo para scripts de extracción local)
# Los PDFs no se incluyen en el repositorio. Usa rutas relativas o absolutas locales.
# ARCANAGRAPH_JODOROWSKY_PDF=data/sources/pdfs/la_via_del_tarot.pdf
# ARCANAGRAPH_CANSECO_PDF=data/sources/pdfs/el_tarot_canseco.pdf
# ARCANAGRAPH_BRAIN_FACTS_PDF=data/sources/pdfs/brain_facts.pdf
# ARCANAGRAPH_NEURO_PDF2=data/sources/pdfs/neuro_pdf2.pdf
